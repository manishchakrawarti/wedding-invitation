# Copy to .env and fill in. Everything is optional for local testing:
# without keys, payments are simulated, images use the offline generator,
# and WhatsApp/email messages are only logged in the admin panel.

# --- Brand ---
BRAND_NAME="Invite All"
BRAND_TAGLINE="Beautiful invitations for weddings and every occasion, ready to share on WhatsApp"
ORDER_PREFIX=IA
FACEBOOK_URL=
YOUTUBE_URL=
X_URL=
PINTEREST_URL=
INSTAGRAM_HANDLE=inviteall
WHATSAPP_NUMBER=918787035854
SUPPORT_EMAIL=sales.team.official.id@gmail.com
BUSINESS_CITY=India
OWNER_WHATSAPP=
OWNER_EMAIL=

BASE_URL=http://localhost:8000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Razorpay (dashboard.razorpay.com → Settings → API keys / Webhooks) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# No API keys yet? Customers pay on your Razorpay.me page and you confirm each payment in admin.
# Ignored once RAZORPAY_KEY_ID/SECRET are set.
RAZORPAY_ME_URL=
ADVANCE_PERCENT=50

# --- Gemini (aistudio.google.com → Get API key) ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_COST_INR=3.5
AUTO_SEND_PROOF_IF_QC_PASS=false

# --- Search engines (optional: only if you verify with the HTML-tag method instead of DNS) ---
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Telegram bot (free): your alerts, customers' PDF + updates, guests' personal PDF ---
# In Telegram, message @BotFather → /newbot → paste the token here. The webhook sets itself up.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OWNER_CHAT_ID=

# --- WhatsApp Cloud API (developers.facebook.com → WhatsApp). PAID per message: leave empty to stay free ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-verify

# --- Email (any SMTP: Gmail app password, Zoho, SES…) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Storage / database ---
STORAGE_BACKEND=local
GCS_BUCKET=
DATABASE_URL=
PHOTO_RETENTION_DAYS=30
FINAL_RETENTION_DAYS=90
MAX_FREE_REVISIONS=2
REFERRAL_DISCOUNT_INR=100

# Secret ₹1 test orders at /order?test=<code> (leave empty to disable)
TEST_ORDER_CODE=
TEST_ORDER_PRICE_INR=1

# Secret coupon that unlocks a ₹99 preview for free (owner testing). Empty = disabled.
TEST_COUPON_CODE=
